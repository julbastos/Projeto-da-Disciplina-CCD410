# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA suba o arquivo .env para o GitHub.

# Neon (PostgreSQL) - connection string com sslmode=require
POSTGRES_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/biblioteca?sslmode=require

# MongoDB Atlas - connection string (mongodb+srv://...)
MONGO_URL=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# DataStax Astra DB (Cassandra)
ASTRA_BUNDLE_PATH=./secure-connect-biblioteca.zip
ASTRA_TOKEN=AstraCS:xxxxxxxxxxxxxxxx
ASTRA_KEYSPACE=biblioteca
